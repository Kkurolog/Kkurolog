# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
#   cp .env.example .env

# 프론트엔드 주소 (CORS 허용). 여러 개면 쉼표로 구분
FRONTEND_ORIGINS=http://localhost:3000

# ---- /ask 호출 횟수 제한 (안 쓰면 app/config.py 의 기본값 사용) ----
# 0 이면 분당 제한 없음 (기본값 0)
# RATE_LIMIT_CLIENT_PER_MINUTE=0
# RATE_LIMIT_CLIENT_PER_DAY=30
# RATE_LIMIT_IP_PER_MINUTE=120
# RATE_LIMIT_IP_PER_DAY=1500
# RATE_LIMIT_GLOBAL_PER_DAY=2000
# 배포(Render)에서는 true: 프록시 뒤에서 학생 IP를 X-Forwarded-For 헤더로 읽는다. 로컬은 false
# TRUST_PROXY_HEADERS=false
# 서버 앞 프록시 개수. X-Forwarded-For 의 오른쪽에서 이 개수만큼 센 값을 학생 IP로 쓴다 (Render 는 1)
# TRUSTED_PROXY_COUNT=1

# ---- 실제 RAG 사용 (기본 false = demo 답변). true 로 바꾸려면 pip install -r requirements-rag.txt ----
# 검색은 Supabase 의 match_chunks 함수(supabase/migrations/0001_experience_tables.sql)로 한다.
# chunks.embedding 이 채워져 있어야 검색 결과가 나온다 (임베딩은 태그 검수 후 다음 단계, DECISIONS.md)
# RAG_ENABLED=false
# Supabase 대신 로컬 파일로 검색할 때만: Chunk 모양(app/rag/models.py) + embedding 이 한 줄씩 든 jsonl
# RAG_LOCAL_CHUNKS=../data/processed/chunks_embedded.jsonl
# 검색·모델 설정은 KKUROLOG_필드이름 으로 바꿀 수 있다 (app/rag/config.py). 예:
# KKUROLOG_TOP_K=8
# KKUROLOG_SIMILARITY_FLOOR=0.3

# ---- 나중에 실제 RAG를 붙일 때 사용 (지금은 비워 두세요) ----
# SUPABASE_URL=
# SUPABASE_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
