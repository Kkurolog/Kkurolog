# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
#   cp .env.example .env

# 프론트엔드 주소 (CORS 허용). 여러 개면 쉼표로 구분
FRONTEND_ORIGINS=http://localhost:3000

# ---- /ask 호출 횟수 제한 (안 쓰면 app/config.py 의 기본값 사용) ----
# RATE_LIMIT_CLIENT_PER_MINUTE=5
# RATE_LIMIT_CLIENT_PER_DAY=30
# RATE_LIMIT_IP_PER_MINUTE=60
# RATE_LIMIT_IP_PER_DAY=1000
# RATE_LIMIT_GLOBAL_PER_DAY=2000
# 배포(Render)에서는 true: 프록시 뒤에서 학생 IP를 X-Forwarded-For 헤더로 읽는다. 로컬은 false
# TRUST_PROXY_HEADERS=false

# ---- 나중에 실제 RAG를 붙일 때 사용 (지금은 비워 두세요) ----
# SUPABASE_URL=
# SUPABASE_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
