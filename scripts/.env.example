# scripts 실행에 필요한 값. 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git에 올라가지 않음)

# Supabase 대시보드 → Project Settings → API
SUPABASE_URL=
# Secret key (service_role 권한). 절대 공유·커밋 금지
SUPABASE_SECRET_KEY=

# Supabase 대시보드 → Connect → Session pooler 주소 (postgresql://...pooler.supabase.com:5432/postgres)
SUPABASE_DB_URL=
